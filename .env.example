# URL de l'API : /api/v1, relaye par le serveur Vite vers le backend
# (Backend_TerrainApp, docker compose up, port 8090). Fonctionne aussi via un
# tunnel (VS Code, ngrok) ou depuis un telephone du reseau local.
VITE_API_BASE_URL=/api/v1

# Contact support (feuille "Besoin d'aide ?" en bas de page).
VITE_SUPPORT_TELEPHONE=+221770000000
VITE_SUPPORT_EMAIL=support@exemple.sn

# Marque du complexe (marque blanche). Vide = TerrainApp.
# En developpement : VITE_MARQUE_* ; en Docker : MARQUE_* (sans VITE_), lues
# au demarrage du conteneur. Memes valeurs que le back-office.
# VITE_MARQUE_NOM=Arena Thiès
# VITE_MARQUE_NOM_ACCENT=Thiès         # fin du nom dans la couleur de marque
# VITE_MARQUE_INITIALES=AT             # monogramme (defaut : deduit du nom)
# VITE_MARQUE_LOGO_URL=                # image qui remplace le monogramme
# VITE_MARQUE_SLOGAN=Votre terrain, réservé en une minute.
# VITE_MARQUE_SOUS_TITRE=Réservation en ligne · Thiès
# VITE_MARQUE_COULEUR=#1F7A4D           # couleur principale (#RRGGBB)
# VITE_MARQUE_COULEUR_CLAIRE=           # accent sur fond sombre (defaut : calcule)
# VITE_MARQUE_ADRESSE=Route de Dakar, Thiès
# VITE_MARQUE_WHATSAPP=+221770000000
